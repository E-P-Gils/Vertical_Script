# Copy to .env in the project root (backend loads root .env).

# --- OpenAI (required for fine-tune + embeddings) ---
OPENAI_API_KEY=
# Optional overrides (defaults exist in server.js):
# OPENAI_FINETUNED_MODEL=
# OPENAI_TRANSLATION_MODEL=

# --- Moonshot / Kimi (hybrid: planner + main generator) ---
# When MOONSHOT_API_KEY is set, PLANNER and GENERATOR default to kimi-k3.
# The OpenAI fine-tuned model stays on OpenAI for format rescue / style / trim.
# MOONSHOT_API_KEY=
# OPENAI_BASE_URL_KIMI=https://api.moonshot.ai/v1
# OPENAI_GENERATOR_MODEL=kimi-k3
# OPENAI_PLANNER_MODEL=kimi-k3
# Kimi K3 always thinks — low | high | max (default low for cost on 60-ep runs)
# KIMI_REASONING_EFFORT=low
# Optional: also route recap/translation to Kimi
# OPENAI_RECAP_MODEL=kimi-k3
# OPENAI_TRANSLATION_MODEL=kimi-k3
# OPENAI_NAME_VALIDATION_MODEL=kimi-k3

# --- Background generation: same pipeline as streaming, plus DB persistence ---
# When AUTH_ENABLED=true and JWT_SECRET are set, /generate requires a Bearer token.
# When Postgres is configured, logged-in users use POST /generate/background (continues if tab closes).
AUTH_ENABLED=true
JWT_SECRET=

# Postgres: prefer a single connection string (Render / Neon / local Docker).
DATABASE_URL=
# Or discrete vars (SSL used automatically):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=vertical
# PGPASSWORD=vertical
# PGDATABASE=vertical_script

# Optional: set to true on local dev if you do not want "generating" rows marked failed on each server restart.
# SKIP_STUCK_GENERATION_RESET=true

# --- Owner / admin (/owner/* APIs + Owner tab in the app) ---
# Comma- or semicolon-separated list of account emails (must match JWT email after login).
# If unset, the server uses a built-in default list (see DEFAULT_OWNER_OPS_EMAILS in server.js).
# Set this on Render (or in .env) so production always has an explicit allowlist:
OWNER_OPS_EMAIL=sculptoid11@gmail.com,imwuqi57@gmail.com
# Optional alias (same parsing); if both are set, OWNER_OPS_EMAILS wins over OWNER_OPS_EMAIL in code — prefer one.
# OWNER_OPS_EMAILS=sculptoid11@gmail.com,imwuqi57@gmail.com
# Static frontend build: same list so the Owner tab appears (Vite embeds at build time).
# VITE_OWNER_OPS_EMAIL=sculptoid11@gmail.com,imwuqi57@gmail.com

# --- Episode length target (~120 EN pages for 60 episodes) ---
# Default 1650 chars/ep. Establishing episodes 1–3 get 1.6× room for world/backstory/openings.
# EPISODE_TARGET_CHARS=1650
# ESTABLISHING_EPISODES=3
# ESTABLISHING_LENGTH_MULTIPLIER=1.6
# PRIMARY_EPISODE_MAX_TOKENS=950

# --- Episode length trim (soft gate) ---
# Condense overlong episodes before recap/persist. Protects cold opens; cuts only redundancy.
# ENABLE_EPISODE_LENGTH_TRIM=true
# MAX_LENGTH_TRIM_ATTEMPTS=1

# --- Episode size guard (runaway / hallucination length) ---
# Defaults: ~260 non-empty lines or 24k chars → treats as quality collapse and runs the existing collapse rescue.
# EPISODE_LENGTH_GATE_ENABLED=false
# EPISODE_MAX_NONEMPTY_LINES=260
# EPISODE_MAX_CHARS=24000

# --- Render.com ---
# Link the Postgres add-on so DATABASE_URL is injected, then add:
# AUTH_ENABLED=true
# JWT_SECRET=(long random string, e.g. openssl rand -hex 32)

# --- Stripe (Checkout + webhooks) ---
# Server-only secret key (sk_...) and webhook signing secret (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used to build return URLs if STRIPE_SUCCESS_URL/STRIPE_CANCEL_URL are not set
PUBLIC_APP_URL=
# Optional explicit URLs
# STRIPE_SUCCESS_URL=https://yourdomain.com/?stripe=success
# STRIPE_CANCEL_URL=https://yourdomain.com/?stripe=cancel
# Allowlist (comma-separated) if you want to hard-block unknown price IDs
# STRIPE_ALLOWED_PRICE_IDS=price_123,price_456
# Map packs (frontend sends pack ids like "pack_5") → price IDs
# STRIPE_PACK_PRICE_MAP_JSON={"pack_5":"price_...","pack_20":"price_...","pack_100":"price_...","payg_1":"price_..."}
# Map price IDs → credits granted (one-time purchases only)
# STRIPE_PRICE_CREDITS_MAP_JSON={"price_...":1,"price_...":5,"price_...":20,"price_...":100}
# Subscriptions: pack → Stripe price + plan_tier + included credits per billing period (granted on invoice.paid)
# STRIPE_SUBSCRIPTION_PACK_MAP_JSON={"sub_starter":{"price":"price_...","planTier":"starter","monthlyCredits":5},"sub_professional":{"price":"price_...","planTier":"professional","monthlyCredits":20},"sub_business":{"price":"price_...","planTier":"business","monthlyCredits":100}}
# If you pass priceId directly for subscription checkout, map each price:
# STRIPE_SUBSCRIPTION_PRICE_DETAILS_JSON={"price_...":{"planTier":"starter","monthlyCredits":5}}
# Webhooks: enable Checkout + invoice.paid + customer.subscription.deleted (and related) in Stripe Dashboard
#
# --- Map your Stripe Prices (price_...) to app pack keys (from Pricing page buttons) ---
# One-time (payment mode): each key must appear in STRIPE_PACK_PRICE_MAP_JSON and its price in STRIPE_PRICE_CREDITS_MAP_JSON.
#   payg_1          → "Pay as you go" (¥120) → 1 script credit
#   pack_5          → 5Batch (¥400) → 5 credits
#   pack_20         → 20Batch (¥1,200) → 20 credits
#   pack_100        → 100Batch (¥4,000) → 100 credits
# Subscriptions: STRIPE_SUBSCRIPTION_PACK_MAP_JSON (monthlyCredits must match plan copy: 5 / 20 / 100)
#   sub_starter     → Starter (¥599/mo) → planTier starter, monthlyCredits 5
#   sub_professional → Professional (¥2,999/mo) → professional, 20
#   sub_business    → Business (¥9,999/mo) → business, 100
# Optional: map extra one-off prices (e.g. StarterScript) in STRIPE_PRICE_CREDITS_MAP_JSON if you call checkout with priceId.
