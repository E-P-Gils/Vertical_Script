# Copy to .env in the project root (backend loads root .env).

# --- OpenAI (required for generation) ---
OPENAI_API_KEY=
# Optional overrides (defaults exist in server.js):
# OPENAI_FINETUNED_MODEL=
# OPENAI_GENERATOR_MODEL=
# OPENAI_TRANSLATION_MODEL=

# --- Background generation: same pipeline as streaming, plus DB persistence ---
# When AUTH_ENABLED=true and JWT_SECRET are set, /generate requires a Bearer token.
# When Postgres is configured, logged-in users use POST /generate/background (continues if tab closes).
AUTH_ENABLED=true
JWT_SECRET=

# Postgres: prefer a single connection string (Render / Neon / local Docker).
DATABASE_URL=
# Or discrete vars (SSL used automatically):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=vertical
# PGPASSWORD=vertical
# PGDATABASE=vertical_script

# Optional: set to true on local dev if you do not want "generating" rows marked failed on each server restart.
# SKIP_STUCK_GENERATION_RESET=true

# --- Episode size guard (runaway / hallucination length) ---
# Defaults: ~260 non-empty lines or 24k chars → treats as quality collapse and runs the existing collapse rescue.
# EPISODE_LENGTH_GATE_ENABLED=false
# EPISODE_MAX_NONEMPTY_LINES=260
# EPISODE_MAX_CHARS=24000

# --- Render.com ---
# Link the Postgres add-on so DATABASE_URL is injected, then add:
# AUTH_ENABLED=true
# JWT_SECRET=(long random string, e.g. openssl rand -hex 32)
